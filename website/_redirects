# Cloudflare Pages redirects for vultron.vercel.app.
# Vultron Credits accounts live on a separate host (account.vultron.vercel.app, the vultron-cloud service). People
# who look for "login" on the marketing site type these paths and used to land on the 404 page (issue #76).
/login       https://account.vultron.vercel.app/login 302
/log-in      https://account.vultron.vercel.app/login 302
/signin      https://account.vultron.vercel.app/login 302
/sign-in     https://account.vultron.vercel.app/login 302
/signup      https://account.vultron.vercel.app/login 302
/sign-up     https://account.vultron.vercel.app/login 302
/register    https://account.vultron.vercel.app/login 302
/account     https://account.vultron.vercel.app/account 302
/account/*   https://account.vultron.vercel.app/account/:splat 302
