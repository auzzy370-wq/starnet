{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node -e \"process.exit(0)\"",
  "buildCommand": "node scripts/stage-website-deploy.mjs",
  "outputDirectory": "website-deploy",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/login", "destination": "/#get", "permanent": false },
    { "source": "/log-in", "destination": "/#get", "permanent": false },
    { "source": "/signin", "destination": "/#get", "permanent": false },
    { "source": "/sign-in", "destination": "/#get", "permanent": false },
    { "source": "/signup", "destination": "/#get", "permanent": false },
    { "source": "/sign-up", "destination": "/#get", "permanent": false },
    { "source": "/register", "destination": "/#get", "permanent": false },
    { "source": "/account", "destination": "/#get", "permanent": false },
    { "source": "/account/(.*)", "destination": "/#get", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://api.github.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/.well-known/vultron-skills.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/vultron-skills.json.sig",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/vultron-skills-revoked.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/vultron-skills-revoked.json.sig",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/vultron-maps.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    {
      "source": "/.well-known/vultron-maps.json.sig",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    },
    { "source": "/skills/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/maps/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
