# Vultron station for Vercel's Container runtime (beta).
#
# Same full app as the root Dockerfile — UI + engine + every /api route — but adapted
# to how Vercel runs container images:
#   - traffic arrives on the port from the project's PORT environment variable (set it to 8080),
#   - there is no attached volume, so the workspace lives on the container's ephemeral disk
#     (a cold start is a fresh station),
#   - no HEALTHCHECK: Vercel probes readiness by the port, not by image health checks.
#
#   vercel deploy   (or push the branch a Vercel project is connected to)

FROM node:22-bookworm-slim AS deps
WORKDIR /app
# node-pty is a native addon (the terminal); the rest of the tree installs cleanly without scripts.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
# --ignore-scripts: kokoro-js -> onnxruntime-node tries to fetch a CUDA tarball that 404s on Linux x64 and
# fails the whole install. The voice stack loads lazily, so the station runs without those binaries.
RUN npm ci --ignore-scripts --no-audit --no-fund && npm rebuild node-pty --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    HOME=/tmp/station \
    VULTRON_WORKSPACES=/tmp/station/workspaces
WORKDIR /app
RUN mkdir -p /tmp/station/workspaces
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 8080
CMD ["node", "scripts/station-serve.js"]
